rules_version = '2';

// Paste this into Firebase console → Firestore Database → Rules → Publish.
// Anyone can sign in with Google; each person can only read and write their own data.
service cloud.firestore {
  match /databases/{database}/documents {
    function me() { return request.auth != null ? request.auth.uid : null; }

    // Private: profile, daily logs, journal, meals
    match /users/{uid} {
      allow read, write: if me() == uid;

      match /entries/{entryId} {
        allow read, delete: if me() == uid;
        allow create, update: if me() == uid
          && request.resource.data.kcal is int
          && request.resource.data.kcal >= 0 && request.resource.data.kcal < 20000;
      }
    }

    // Partner view: a small summary the owner writes; linked partners can read it
    // and may only add a cheer.
    match /shares/{uid} {
      allow read: if me() == uid || (me() != null && me() in resource.data.partners);
      allow create, delete: if me() == uid;
      allow update: if me() == uid
        || (me() != null && me() in resource.data.partners
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cheers']));
    }

    // Pairing codes: fetched one at a time by code (no listing), accepted once.
    match /invites/{code} {
      allow get: if me() != null;
      allow create: if me() != null && request.resource.data.uid == me();
      allow update: if me() != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedBy', 'acceptedName'])
        && request.resource.data.acceptedBy == me();
      allow delete: if me() == resource.data.uid;
    }

    // Scale sync inbox: the owner creates it; whoever holds the secret key in the
    // document name (the owner's phone Shortcut) can only set the weight and time.
    match /inbox/{key} {
      allow create: if me() != null && request.resource.data.uid == me();
      allow read, delete: if me() == resource.data.uid;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['weight', 'at'])
        && request.resource.data.weight is number
        && request.resource.data.weight > 20 && request.resource.data.weight < 400;
    }
  }
}
